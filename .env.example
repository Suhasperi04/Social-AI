# ===========================================
# GrowMyAccount AI - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Instagram OAuth (https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_APP_ID=
META_REDIRECT_URI=http://localhost:3000/api/auth/callback

# AI Models (Fallback chain: Gemini -> OpenAI -> Claude -> DeepSeek -> Qwen)
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
